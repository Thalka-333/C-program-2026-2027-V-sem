#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool wordBreak(char* s, char** wordDict, int wordDictSize) {
    int n = strlen(s);
    
    // Allocate dp array of size n + 1
    bool* dp = (bool*)calloc(n + 1, sizeof(bool));
    dp[0] = true; // Base case: empty string
    
    for (int i = 1; i <= n; i++) {
        for (int j = 0; j < i; j++) {
            // If the prefix s[0:j] is valid
            if (dp[j]) {
                int len = i - j;
                
                // Check if s[j:i] matches any word in the dictionary
                for (int k = 0; k < wordDictSize; k++) {
                    if ((int)strlen(wordDict[k]) == len && strncmp(s + j, wordDict[k], len) == 0) {
                        dp[i] = true;
                        break;
                    }
                }
                
                if (dp[i]) break; // Found a valid segmentation, move to next i
            }
        }
    }
    
    bool result = dp[n];
    free(dp);
    return result;
}
